# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# SQLite databases (local & test state)
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment variables & API keys
.env
.env.*

# Runtime trace logs (keep folder tracked, ignore generated logs)
traces/*
